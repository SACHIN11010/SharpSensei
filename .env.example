# Port number for local dev server (default: 3000)
PORT=3000

# Server Environment
NODE_ENV=development

# APP_URL: The local URL where SharpSensei is running
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: (Optional for local dev)
# If provided, enables online Google Gemini 3.7 / 3.1 Flash AI responses.
# If omitted/blank, SharpSensei automatically uses its built-in offline C# Knowledge Engine.
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

